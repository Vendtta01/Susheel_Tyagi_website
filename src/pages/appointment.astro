---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Book Appointment | Dr. Susheel Tyagi"
  description="Book a consultation with Dr. Susheel Tyagi at MEDIIX Clinic, Indirapuram, Ghaziabad."
>
  <main class="max-w-[1280px] mx-auto px-gutter py-section-padding-mobile md:py-section-padding-desktop flex-grow">

    <!-- HERO -->
    <div class="text-center mb-16">
      <p class="hero-line-1 text-label-md font-label-md text-secondary uppercase tracking-widest mb-3">Book a Consultation</p>
      <h1 class="hero-line-2 text-display-lg-mobile md:text-display-lg font-display-lg text-primary mb-4">Request a Consultation</h1>
      <p class="hero-line-3 text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Schedule your appointment for expert medical care. Please fill out the form below — our team will confirm your slot via call within 24 hours.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT INFO -->
      <div class="lg:col-span-4 space-y-6">
        <div class="reveal reveal-left bg-surface rounded-xl p-8 ambient-shadow border border-outline-variant/30 border-t-2 border-t-secondary relative overflow-hidden">
          <div class="absolute -right-6 -top-6 text-surface-container opacity-50 pointer-events-none">
            <span class="material-symbols-outlined" style="font-size: 120px;">calendar_today</span>
          </div>
          <div class="relative z-10">
            <h3 class="text-headline-sm font-headline-sm text-primary mb-6 flex items-center">
              <span class="material-symbols-outlined mr-2 text-secondary icon-fill">contact_support</span>
              Need Assistance?
            </h3>
            <div class="space-y-6">
              <div class="flex items-start">
                <span class="material-symbols-outlined text-secondary mr-4 mt-1 icon-fill">call</span>
                <div>
                  <p class="text-label-md font-label-md text-on-surface-variant mb-1 uppercase tracking-wider">Direct Line</p>
                  <a class="text-body-lg font-body-lg text-primary font-medium hover:text-secondary transition-colors" href="tel:07303190200">073031 90200</a>
                </div>
              </div>
              <div class="flex items-start">
                <span class="material-symbols-outlined text-secondary mr-4 mt-1 icon-fill">location_on</span>
                <div>
                  <p class="text-label-md font-label-md text-on-surface-variant mb-1 uppercase tracking-wider">Clinic Location</p>
                  <p class="text-body-md font-body-md text-primary">MEDIIX Clinic<br />Plot No. 367, 14/3, Mayur Vihar,<br />Niti Khand 2, Indirapuram, Ghaziabad</p>
                </div>
              </div>
              <div class="flex items-start">
                <span class="material-symbols-outlined text-secondary mr-4 mt-1 icon-fill">schedule</span>
                <div>
                  <p class="text-label-md font-label-md text-on-surface-variant mb-1 uppercase tracking-wider">Clinic Hours</p>
                  <p class="text-body-md font-body-md text-primary">Mon &ndash; Sat: 9:00 AM &ndash; 7:00 PM</p>
                  <p class="text-caption font-caption text-on-surface-variant mt-1">Closed Sunday</p>
                </div>
              </div>
            </div>
            <div class="mt-8 p-4 bg-surface-container rounded-lg border border-outline-variant/20">
              <p class="text-caption font-caption text-on-surface-variant flex items-start">
                <span class="material-symbols-outlined text-secondary text-[16px] mr-2 mt-0.5 icon-fill">info</span>
                We prioritise urgent cases. If this is a medical emergency, please call emergency services immediately.
              </p>
            </div>
          </div>
        </div>

        <div class="reveal reveal-left bg-primary text-on-primary rounded-xl p-8 ambient-shadow relative overflow-hidden" data-delay="100">
          <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-secondary-fixed to-transparent pointer-events-none"></div>
          <div class="flex items-center space-x-4 relative z-10">
            <div class="w-12 h-12 rounded-full bg-secondary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-on-secondary icon-fill">verified</span>
            </div>
            <div>
              <h4 class="text-body-lg font-body-lg font-semibold text-on-primary">Gold Standard Care</h4>
              <p class="text-body-md font-body-md text-on-primary/70">FACP, FICP, FIACM &amp; FDIAI Fellow</p>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT FORM -->
      <div class="lg:col-span-8 reveal reveal-right bg-surface rounded-xl p-8 md:p-10 ambient-shadow border border-outline-variant/30">
        <form class="space-y-6" data-validate data-success-msg="Thank you! We'll confirm your appointment via call within 24 hours.">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="form-field">
              <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="fullName">Full Name <span class="text-error">*</span></label>
              <input class="w-full bg-transparent border border-outline-variant rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface placeholder:text-outline" id="fullName" name="fullName" placeholder="Enter your full name" type="text" required />
            </div>
            <div class="form-field">
              <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="phone">Phone Number <span class="text-error">*</span></label>
              <input class="w-full bg-transparent border border-outline-variant rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface placeholder:text-outline" id="phone" name="phone" placeholder="+91 ..." type="tel" required />
            </div>
          </div>

          <div class="form-field">
            <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="email">Email Address</label>
            <input class="w-full bg-transparent border border-outline-variant rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface placeholder:text-outline" id="email" name="email" placeholder="you@example.com" type="email" />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="form-field">
              <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="date">Preferred Date <span class="text-error">*</span></label>
              <div class="relative">
                <input class="w-full bg-transparent border border-outline-variant rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface appearance-none pr-12" id="date" name="date" type="date" required />
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline pointer-events-none">calendar_month</span>
              </div>
            </div>
            <div class="form-field">
              <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="time">Preferred Time <span class="text-error">*</span></label>
              <div class="relative">
                <select class="w-full bg-transparent border border-outline-variant rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface appearance-none pr-12" id="time" name="time" required>
                  <option value="">Select Morning or Evening</option>
                  <option value="morning">Morning (9 AM &ndash; 1 PM)</option>
                  <option value="evening">Evening (4 PM &ndash; 7 PM)</option>
                </select>
                <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
              </div>
            </div>
          </div>

          <div class="form-field">
            <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="concern">Primary Concern</label>
            <div class="relative">
              <select class="w-full bg-transparent border border-outline-variant rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface appearance-none pr-12" id="concern" name="concern">
                <option value="">Select a category (optional)</option>
                <option value="diabetes">Diabetes Management</option>
                <option value="hypertension">Hypertension</option>
                <option value="obesity">Obesity / Weight Management</option>
                <option value="infection">Infection / Fever / Other</option>
                <option value="metabolic">Metabolic / Endocrine</option>
                <option value="general">General Internal Medicine</option>
              </select>
              <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline pointer-events-none">expand_more</span>
            </div>
          </div>

          <div class="form-field">
            <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="reason">Reason for Visit</label>
            <textarea class="w-full bg-transparent border border-outline-variant rounded-lg px-4 py-3 text-body-md font-body-md text-on-surface placeholder:text-outline resize-none" id="reason" name="reason" placeholder="Briefly describe your symptoms or reason for consultation..." rows="4"></textarea>
          </div>

          <div class="flex items-center space-x-3 py-4">
            <span class="material-symbols-outlined text-secondary icon-fill">check_circle</span>
            <p class="text-body-md font-body-md text-on-surface-variant italic">
              We will confirm your appointment via call within 24 hours.
            </p>
          </div>

          <div class="pt-4 border-t border-outline-variant/20 flex flex-col sm:flex-row gap-4">
            <button class="btn-primary w-full sm:w-auto bg-primary text-on-primary px-8 py-4 rounded-DEFAULT text-label-md font-label-md inline-flex items-center justify-center gap-2 ambient-shadow" type="submit">
              <span>Request Appointment</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
            <a class="btn-outline w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-primary text-primary hover:border-secondary hover:text-secondary px-8 py-4 rounded-DEFAULT text-label-md font-label-md" href="tel:07303190200">
              <span class="material-symbols-outlined text-[18px]">call</span>
              Call Instead
            </a>
          </div>
        </form>
      </div>
    </div>

  </main>
</Layout>
