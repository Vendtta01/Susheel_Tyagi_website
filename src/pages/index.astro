---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Dr. Susheel Tyagi | Senior Consultant Physician — Internal Medicine">

  <main class="flex-grow">

    <!-- =============== HERO =============== -->
    <section class="px-gutter pt-section-padding-mobile md:pt-section-padding-desktop pb-section-padding-mobile max-w-[1280px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-8">
          <div class="hero-line-1 inline-flex items-center gap-2 bg-secondary/10 text-secondary px-4 py-2 rounded-full text-label-md font-label-md uppercase tracking-wider">
            <span class="material-symbols-outlined icon-fill text-[18px]">verified</span>
            FACP &middot; FICP &middot; FIACM &middot; FDIAI Fellow
          </div>
          <h1 class="hero-line-2 text-display-lg-mobile md:text-display-lg font-display-lg text-primary text-balance">
            16+ Years of Excellence in <span class="text-gradient-gold">Internal Medicine</span>
          </h1>
          <p class="hero-line-3 text-body-lg font-body-lg text-on-surface-variant max-w-2xl text-balance">
            Compassionate care. Precise diagnosis. Trusted by families across Delhi NCR for the management of diabetes, hypertension, obesity, infectious diseases, and metabolic disorders.
          </p>
          <div class="hero-line-3 flex flex-col sm:flex-row gap-4 pt-4">
            <a class="btn-primary inline-flex justify-center items-center gap-2 px-8 py-4 bg-primary text-on-primary rounded-DEFAULT text-label-md font-label-md ambient-shadow" href="/appointment">
              <span class="material-symbols-outlined text-[18px]">calendar_month</span>
              Book an Appointment
            </a>
            <a class="btn-outline inline-flex justify-center items-center gap-2 px-8 py-4 border-2 border-primary text-primary hover:border-secondary hover:text-secondary rounded-DEFAULT text-label-md font-label-md" href="/about">
              Learn More About Dr. Tyagi
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 relative">
          <div class="portrait-in aspect-[4/5] rounded-xl overflow-hidden ambient-shadow border border-outline-variant/30 relative group">
            <img
              alt="Portrait of Dr. Susheel Tyagi"
              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
              src="/assets/dr-tyagi.jpg"
              onerror="this.onerror=null;this.src='https://lh3.googleusercontent.com/aida-public/AB6AXuDBbVn_i7YN5oyZxNxnaZQQ_y4z2gCp-NA8RHusyrFnYSTjF8We6Ddv0cr4cFP6rxRWYmHgb5BZDwN-LfqLsSvVTclJtf3ZcajMRmlp_nHIMMoegLIkk9GTKxI6qJAbq-eE9-eEulP5Vasmmk6hHW4vhskKSN8Cr_PG8mZz1K-CoECGNGfW3p0fFlr_FvQPzZMgXDBjMC08STchZNB1-EV4lei447F6a_UDWlktKjqID6FU3NgfAMieEqrlQfHb2xPbillYsExDNT0';"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/15 via-transparent to-transparent pointer-events-none"></div>
          </div>
          <div class="absolute -bottom-6 -left-6 bg-surface-container-lowest rounded-xl p-4 ambient-shadow border border-outline-variant/30 hidden md:flex items-center gap-3 max-w-[220px]">
            <div class="w-10 h-10 rounded-full bg-secondary/15 text-secondary flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined icon-fill">school</span>
            </div>
            <div>
              <p class="text-caption font-caption text-on-surface-variant uppercase tracking-wider">Trained at</p>
              <p class="text-label-md font-label-md text-primary leading-tight">KGMU Lucknow &middot; RCP, UK</p>
            </div>
          </div>
          <div class="float-blob absolute -top-6 -right-6 w-40 h-40 bg-secondary-container/30 rounded-full blur-3xl -z-10"></div>
        </div>
      </div>
    </section>

    <!-- =============== STATS =============== -->
    <section class="bg-surface-container py-12 px-gutter border-y border-outline-variant/20">
      <div class="max-w-[1280px] mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-outline-variant/30">
          <div class="reveal text-center px-4">
            <p class="text-headline-md font-headline-md text-primary mb-2">
              <span class="counter" data-target="16" data-suffix="+">0+</span>
            </p>
            <p class="text-label-md font-label-md text-on-surface-variant">Years Experience</p>
          </div>
          <div class="reveal text-center px-4" data-delay="100">
            <p class="text-headline-md font-headline-md text-secondary mb-2 flex items-center justify-center gap-1">
              <span class="counter" data-target="4.9" data-decimals="1">0.0</span>
              <span class="material-symbols-outlined icon-fill text-2xl">star</span>
            </p>
            <p class="text-label-md font-label-md text-on-surface-variant">Google Rating</p>
          </div>
          <div class="reveal text-center px-4" data-delay="200">
            <p class="text-headline-md font-headline-md text-primary mb-2">
              <span class="counter" data-target="92" data-suffix="+">0+</span>
            </p>
            <p class="text-label-md font-label-md text-on-surface-variant">Patient Reviews</p>
          </div>
          <div class="reveal text-center px-4" data-delay="300">
            <p class="text-headline-md font-headline-md text-primary mb-2 flex justify-center items-center gap-2">
              <span class="material-symbols-outlined text-3xl text-secondary icon-fill">verified</span>
            </p>
            <p class="text-label-md font-label-md text-on-surface-variant">FACP &amp; FICP Fellow</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =============== EXPERTISE BENTO =============== -->
    <section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter bg-background">
      <div class="max-w-[1280px] mx-auto">
        <div class="text-center mb-16 reveal">
          <p class="text-label-md font-label-md text-secondary uppercase tracking-widest mb-3">Specialties</p>
          <h2 class="text-headline-md font-headline-md text-primary mb-4">Areas of Expertise</h2>
          <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto">
            Comprehensive medical care with a focus on accurate diagnosis and personalised, evidence-based treatment plans.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <a href="/expertise#diabetes" class="reveal lift-card bg-surface rounded-xl p-8 border border-outline-variant/30 ambient-shadow group block">
            <div class="w-12 h-12 bg-primary-container text-on-primary-container rounded-lg flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
              <span class="material-symbols-outlined text-2xl">water_drop</span>
            </div>
            <h3 class="text-headline-sm font-headline-sm text-primary mb-3">Diabetes Management</h3>
            <p class="text-body-md font-body-md text-on-surface-variant">Advanced care plans for Type 1, Type 2, and gestational diabetes — including insulin titration and CGM monitoring.</p>
          </a>
          <a href="/expertise#hypertension" class="reveal lift-card bg-surface rounded-xl p-8 border border-outline-variant/30 ambient-shadow group block" data-delay="100">
            <div class="w-12 h-12 bg-primary-container text-on-primary-container rounded-lg flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
              <span class="material-symbols-outlined text-2xl">favorite</span>
            </div>
            <h3 class="text-headline-sm font-headline-sm text-primary mb-3">Hypertension</h3>
            <p class="text-body-md font-body-md text-on-surface-variant">Expert diagnosis and management of high blood pressure to prevent cardiovascular complications.</p>
          </a>
          <a href="/expertise#infectious" class="reveal lift-card bg-surface rounded-xl p-8 border border-outline-variant/30 ambient-shadow group block" data-delay="200">
            <div class="w-12 h-12 bg-primary-container text-on-primary-container rounded-lg flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
              <span class="material-symbols-outlined text-2xl">coronavirus</span>
            </div>
            <h3 class="text-headline-sm font-headline-sm text-primary mb-3">Infectious Diseases</h3>
            <p class="text-body-md font-body-md text-on-surface-variant">Accurate diagnosis and targeted treatment for a wide range of acute and chronic infections.</p>
          </a>
          <a href="/expertise#obesity" class="reveal lift-card bg-surface rounded-xl p-8 border border-outline-variant/30 ambient-shadow group block">
            <div class="w-12 h-12 bg-primary-container text-on-primary-container rounded-lg flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
              <span class="material-symbols-outlined text-2xl">monitor_weight</span>
            </div>
            <h3 class="text-headline-sm font-headline-sm text-primary mb-3">Obesity &amp; Weight Management</h3>
            <p class="text-body-md font-body-md text-on-surface-variant">SCOPE-certified strategies for sustainable weight loss and improved metabolic health.</p>
          </a>
          <a href="/expertise#metabolic" class="reveal lift-card bg-surface rounded-xl p-8 border border-outline-variant/30 ambient-shadow group block lg:col-span-2 relative overflow-hidden" data-delay="100">
            <div class="flex flex-col md:flex-row gap-6 relative z-10">
              <div class="flex-1">
                <div class="w-12 h-12 bg-primary-container text-on-primary-container rounded-lg flex items-center justify-center mb-6 group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
                  <span class="material-symbols-outlined text-2xl">medical_services</span>
                </div>
                <h3 class="text-headline-sm font-headline-sm text-primary mb-3">Internal Medicine &amp; Metabolic Disorders</h3>
                <p class="text-body-md font-body-md text-on-surface-variant">Holistic management of complex adult diseases — focusing on interconnected bodily systems and metabolic syndrome interventions.</p>
              </div>
            </div>
            <div class="absolute right-0 bottom-0 opacity-5 pointer-events-none">
              <span class="material-symbols-outlined icon-fill" style="font-size: 200px;">health_and_safety</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- =============== ACCOLADES =============== -->
    <section class="py-16 px-gutter bg-primary text-on-primary relative overflow-hidden">
      <div class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-secondary-fixed to-transparent pointer-events-none"></div>
      <div class="max-w-[1280px] mx-auto relative z-10">
        <div class="text-center mb-10 reveal">
          <p class="text-label-md font-label-md text-secondary-fixed uppercase tracking-widest mb-3">Recognised Excellence</p>
          <h2 class="text-headline-md font-headline-md text-on-primary">National &amp; International Fellowships</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="reveal badge-fellow bg-on-primary/10 rounded p-4 border border-on-primary/20 text-center cursor-default">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl block mb-2">military_tech</span>
            <p class="text-label-md font-label-md text-on-primary tracking-wider">FICP</p>
            <p class="text-caption font-caption text-on-primary-container mt-1">Indian College of Physicians</p>
          </div>
          <div class="reveal badge-fellow bg-on-primary/10 rounded p-4 border border-on-primary/20 text-center cursor-default" data-delay="100">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl block mb-2">military_tech</span>
            <p class="text-label-md font-label-md text-on-primary tracking-wider">FACP</p>
            <p class="text-caption font-caption text-on-primary-container mt-1">American College of Physicians</p>
          </div>
          <div class="reveal badge-fellow bg-on-primary/10 rounded p-4 border border-on-primary/20 text-center cursor-default" data-delay="200">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl block mb-2">military_tech</span>
            <p class="text-label-md font-label-md text-on-primary tracking-wider">FIACM</p>
            <p class="text-caption font-caption text-on-primary-container mt-1">Indian Assoc. of Clinical Medicine</p>
          </div>
          <div class="reveal badge-fellow bg-on-primary/10 rounded p-4 border border-on-primary/20 text-center cursor-default" data-delay="300">
            <span class="material-symbols-outlined text-secondary-fixed text-3xl block mb-2">military_tech</span>
            <p class="text-label-md font-label-md text-on-primary tracking-wider">FDIAI</p>
            <p class="text-caption font-caption text-on-primary-container mt-1">Diabetes India</p>
          </div>
        </div>
      </div>
    </section>

    <!-- =============== TESTIMONIALS =============== -->
    <section class="py-section-padding-mobile md:py-section-padding-desktop px-gutter bg-surface-container-low">
      <div class="max-w-[1280px] mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-6 reveal">
          <div>
            <p class="text-label-md font-label-md text-secondary uppercase tracking-widest mb-3">Patient Voices</p>
            <h2 class="text-headline-md font-headline-md text-primary mb-4">Patient Experiences</h2>
            <p class="text-body-lg font-body-lg text-on-surface-variant">Read what families across Delhi NCR say about their care.</p>
          </div>
          <div class="flex gap-2">
            <button class="testi-arrow w-12 h-12 rounded-full border border-outline-variant flex items-center justify-center text-primary hover:bg-surface-container-highest" data-carousel-prev aria-label="Previous testimonial">
              <span class="material-symbols-outlined">arrow_back</span>
            </button>
            <button class="testi-arrow w-12 h-12 rounded-full bg-primary text-on-primary flex items-center justify-center hover:bg-secondary hover:text-on-secondary-fixed ambient-shadow" data-carousel-next aria-label="Next testimonial">
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>
        </div>
        <div class="overflow-hidden reveal" data-carousel>
          <div class="testi-track">
            <div class="testi-card bg-surface rounded-xl p-8 border-t-2 border-t-secondary border-x border-b border-outline-variant/30 ambient-shadow flex flex-col justify-between">
              <div>
                <div class="flex text-secondary mb-4">
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                </div>
                <p class="text-body-md font-body-md text-on-surface-variant italic mb-6">&ldquo;Explains things clearly and makes you feel comfortable. A truly professional and caring approach to treatment.&rdquo;</p>
              </div>
              <p class="text-label-md font-label-md text-primary">— Ajit Singh</p>
            </div>
            <div class="testi-card bg-surface rounded-xl p-8 border-t-2 border-t-secondary border-x border-b border-outline-variant/30 ambient-shadow flex flex-col justify-between">
              <div>
                <div class="flex text-secondary mb-4">
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                </div>
                <p class="text-body-md font-body-md text-on-surface-variant italic mb-6">&ldquo;He listens attentively and provides thoughtful guidance. I appreciate his detailed diagnosis.&rdquo;</p>
              </div>
              <p class="text-label-md font-label-md text-primary">— Om Soni</p>
            </div>
            <div class="testi-card bg-surface rounded-xl p-8 border-t-2 border-t-secondary border-x border-b border-outline-variant/30 ambient-shadow flex flex-col justify-between">
              <div>
                <div class="flex text-secondary mb-4">
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                </div>
                <p class="text-body-md font-body-md text-on-surface-variant italic mb-6">&ldquo;Treated my daughter with great care. His calm demeanor helped reduce our anxiety instantly.&rdquo;</p>
              </div>
              <p class="text-label-md font-label-md text-primary">— Mahesh Sharma</p>
            </div>
            <div class="testi-card bg-surface rounded-xl p-8 border-t-2 border-t-secondary border-x border-b border-outline-variant/30 ambient-shadow flex flex-col justify-between">
              <div>
                <div class="flex text-secondary mb-4">
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                </div>
                <p class="text-body-md font-body-md text-on-surface-variant italic mb-6">&ldquo;Excellent diagnostic skills and a genuinely warm bedside manner. Got my diabetes under control in months.&rdquo;</p>
              </div>
              <p class="text-label-md font-label-md text-primary">— Rakesh Verma</p>
            </div>
            <div class="testi-card bg-surface rounded-xl p-8 border-t-2 border-t-secondary border-x border-b border-outline-variant/30 ambient-shadow flex flex-col justify-between">
              <div>
                <div class="flex text-secondary mb-4">
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                  <span class="material-symbols-outlined icon-fill">star</span>
                </div>
                <p class="text-body-md font-body-md text-on-surface-variant italic mb-6">&ldquo;A highly knowledgeable physician. He spends real time with each patient — never rushed.&rdquo;</p>
              </div>
              <p class="text-label-md font-label-md text-primary">— Priya Chaudhary</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =============== CLINIC STRIP =============== -->
    <section class="bg-primary text-on-primary py-12 px-gutter relative overflow-hidden">
      <div class="max-w-[1280px] mx-auto flex flex-col md:flex-row items-center justify-between gap-8 relative z-10 reveal">
        <div class="flex items-center gap-6">
          <div class="w-16 h-16 rounded-full bg-secondary flex items-center justify-center text-on-secondary-fixed shrink-0">
            <span class="material-symbols-outlined text-3xl icon-fill">location_on</span>
          </div>
          <div>
            <h3 class="text-headline-sm font-headline-sm text-secondary-fixed mb-1">MEDIIX CLINIC</h3>
            <p class="text-body-md font-body-md text-on-primary/80">Indirapuram, Ghaziabad</p>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row items-center gap-6">
          <div class="text-center sm:text-right">
            <p class="text-label-md font-label-md text-secondary-fixed mb-1 uppercase tracking-wider">Call for Appointment</p>
            <a class="text-headline-sm font-headline-sm hover:text-secondary-fixed-dim transition-colors" href="tel:07303190200">073031 90200</a>
          </div>
          <a class="btn-primary inline-flex justify-center items-center gap-2 px-8 py-4 bg-secondary text-on-secondary-fixed rounded-DEFAULT text-label-md font-label-md" href="tel:07303190200">
            <span class="material-symbols-outlined text-[18px]">call</span>
            Call Now
          </a>
        </div>
      </div>
      <div class="absolute right-0 top-0 w-1/3 h-full bg-gradient-to-l from-primary-container to-transparent opacity-50 z-0"></div>
    </section>

  </main>

</Layout>
