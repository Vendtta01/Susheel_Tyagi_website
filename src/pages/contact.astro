---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact & Location | Dr. Susheel Tyagi — MEDIIX Clinic"
  description="Contact Dr. Susheel Tyagi at MEDIIX Clinic, Indirapuram, Ghaziabad. Phone: 07303190200."
>
  <main class="flex-grow pb-section-padding-mobile md:pb-section-padding-desktop">

    <!-- HERO -->
    <section class="px-gutter max-w-[1280px] mx-auto pt-12 md:pt-24 mb-16">
      <div class="text-center max-w-3xl mx-auto">
        <p class="hero-line-1 text-label-md font-label-md text-secondary uppercase tracking-widest mb-3">Get in Touch</p>
        <h1 class="hero-line-2 text-display-lg-mobile md:text-display-lg font-display-lg text-primary mb-6">Contact &amp; Location</h1>
        <p class="hero-line-3 text-body-lg font-body-lg text-on-surface-variant">
          Schedule a consultation or reach out with any inquiries. We are committed to providing the gold standard of medical care in Ghaziabad.
        </p>
      </div>
    </section>

    <!-- QUICK ACTIONS -->
    <section class="px-gutter max-w-[1280px] mx-auto mb-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <a class="reveal lift-card bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-6 ambient-shadow flex items-center gap-4 group" href="tel:07303190200">
          <div class="w-12 h-12 rounded-full bg-secondary/15 text-secondary flex items-center justify-center group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
            <span class="material-symbols-outlined icon-fill">call</span>
          </div>
          <div>
            <p class="text-caption font-caption text-on-surface-variant uppercase tracking-wider">Call Now</p>
            <p class="text-body-lg font-body-lg text-primary font-medium">073031 90200</p>
          </div>
        </a>
        <a class="reveal lift-card bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-6 ambient-shadow flex items-center gap-4 group" href="https://wa.me/917303190200" target="_blank" rel="noopener" data-delay="100">
          <div class="w-12 h-12 rounded-full bg-secondary/15 text-secondary flex items-center justify-center group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
            <span class="material-symbols-outlined icon-fill">chat</span>
          </div>
          <div>
            <p class="text-caption font-caption text-on-surface-variant uppercase tracking-wider">WhatsApp</p>
            <p class="text-body-lg font-body-lg text-primary font-medium">Send a Message</p>
          </div>
        </a>
        <a class="reveal lift-card bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-6 ambient-shadow flex items-center gap-4 group" href="/appointment" data-delay="200">
          <div class="w-12 h-12 rounded-full bg-secondary/15 text-secondary flex items-center justify-center group-hover:bg-secondary group-hover:text-on-secondary-fixed transition-colors">
            <span class="material-symbols-outlined icon-fill">event</span>
          </div>
          <div>
            <p class="text-caption font-caption text-on-surface-variant uppercase tracking-wider">Book Online</p>
            <p class="text-body-lg font-body-lg text-primary font-medium">Request Appointment</p>
          </div>
        </a>
      </div>
    </section>

    <!-- CONTACT GRID -->
    <section class="px-gutter max-w-[1280px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-8">

      <div class="md:col-span-5 flex flex-col gap-8">
        <div class="reveal reveal-left bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-8 ambient-shadow border-t-2 border-t-secondary relative overflow-hidden group">
          <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transition-opacity pointer-events-none">
            <span class="material-symbols-outlined" style="font-size: 120px;">local_hospital</span>
          </div>
          <h2 class="text-headline-sm font-headline-sm text-primary mb-8 relative z-10">MEDIIX CLINIC</h2>
          <div class="space-y-6 relative z-10">
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary mt-1 icon-fill">location_on</span>
              <div>
                <p class="text-label-md font-label-md text-primary mb-1 uppercase tracking-wider">Address</p>
                <p class="text-body-md font-body-md text-on-surface-variant">Plot No. 367, 14/3, Mayur Vihar,<br />Niti Khand 2, Indirapuram, Ghaziabad</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary mt-1 icon-fill">call</span>
              <div>
                <p class="text-label-md font-label-md text-primary mb-1 uppercase tracking-wider">Phone</p>
                <a class="text-body-md font-body-md text-on-surface-variant hover:text-secondary transition-colors" href="tel:07303190200">073031 90200</a>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <span class="material-symbols-outlined text-secondary mt-1 icon-fill">schedule</span>
              <div>
                <p class="text-label-md font-label-md text-primary mb-1 uppercase tracking-wider">Timings</p>
                <p class="text-body-md font-body-md text-on-surface-variant">Morning Session — 9:00 AM to 1:00 PM</p>
                <p class="text-body-md font-body-md text-on-surface-variant">Evening Session — 4:00 PM to 7:00 PM</p>
                <p class="text-caption font-caption text-on-surface-variant mt-2">Closed Sunday</p>
              </div>
            </div>
          </div>
        </div>

        <div class="reveal reveal-left bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-6 ambient-shadow flex items-center justify-between" data-delay="100">
          <div class="flex items-center gap-4">
            <div class="bg-[#EA4335] text-white w-12 h-12 rounded-full flex items-center justify-center font-bold text-lg shadow-sm">G</div>
            <div>
              <p class="text-label-md font-label-md text-primary">Google Reviews</p>
              <div class="flex items-center gap-1 text-[#FBBC05] mt-1">
                <span class="material-symbols-outlined icon-fill">star</span>
                <span class="material-symbols-outlined icon-fill">star</span>
                <span class="material-symbols-outlined icon-fill">star</span>
                <span class="material-symbols-outlined icon-fill">star</span>
                <span class="material-symbols-outlined icon-fill">star</span>
              </div>
            </div>
          </div>
          <div class="text-right">
            <span class="text-headline-md font-headline-md text-primary block">
              <span class="counter" data-target="4.9" data-decimals="1">0.0</span>
            </span>
            <span class="text-caption font-caption text-on-surface-variant">Out of 5</span>
          </div>
        </div>
      </div>

      <div class="md:col-span-7 flex flex-col gap-8">
        <div class="reveal reveal-right bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-8 ambient-shadow">
          <h3 class="text-headline-sm font-headline-sm text-primary mb-6">Send a Message</h3>
          <form class="space-y-6" data-validate data-success-msg="Thanks — your message has been received. We'll respond shortly.">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="form-field">
                <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="name">Full Name <span class="text-error">*</span></label>
                <input class="w-full bg-surface-bright border border-outline-variant/50 rounded-lg px-4 py-3 text-body-md" id="name" name="name" placeholder="Your full name" type="text" required />
              </div>
              <div class="form-field">
                <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="phone">Phone <span class="text-error">*</span></label>
                <input class="w-full bg-surface-bright border border-outline-variant/50 rounded-lg px-4 py-3 text-body-md" id="phone" name="phone" placeholder="+91 ..." type="tel" required />
              </div>
            </div>
            <div class="form-field">
              <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="email">Email Address</label>
              <input class="w-full bg-surface-bright border border-outline-variant/50 rounded-lg px-4 py-3 text-body-md" id="email" name="email" placeholder="you@example.com" type="email" />
            </div>
            <div class="form-field">
              <label class="block text-label-md font-label-md text-primary mb-2 uppercase tracking-wider" for="message">Message <span class="text-error">*</span></label>
              <textarea class="w-full bg-surface-bright border border-outline-variant/50 rounded-lg px-4 py-3 text-body-md resize-none" id="message" name="message" placeholder="How can we help you?" rows="4" required></textarea>
            </div>
            <button class="btn-primary inline-flex items-center justify-center gap-2 bg-primary text-on-primary px-8 py-3 rounded-lg text-label-md font-label-md ambient-shadow" type="submit">
              Send Message
              <span class="material-symbols-outlined text-[18px]">send</span>
            </button>
          </form>
        </div>

        <div class="reveal reveal-right bg-surface-container-lowest border border-outline-variant/30 rounded-xl overflow-hidden ambient-shadow h-72 relative" data-delay="100">
          <iframe
            title="MEDIIX Clinic, Indirapuram, Ghaziabad"
            src="https://www.google.com/maps?q=MEDIIX+Clinic+Indirapuram+Ghaziabad&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-sm px-4 py-2 rounded shadow-sm border border-outline-variant/20 pointer-events-none">
            <p class="text-label-md font-label-md text-primary">MEDIIX CLINIC — Indirapuram</p>
          </div>
        </div>
      </div>
    </section>

  </main>
</Layout>
